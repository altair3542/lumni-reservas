NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Puerto de la demo completa con Docker (web y API en el mismo origen).
APP_PORT=8080
WEB_ORIGIN=http://localhost:5173
POSTGRES_PORT=55432
POSTGRES_PASSWORD=local-demo-change-me
DATABASE_URL=postgresql://lumni:local-demo-change-me@127.0.0.1:55432/lumni_app
TEST_DATABASE_URL=postgresql://lumni:local-demo-change-me@127.0.0.1:55432/lumni_test
SQL_DATABASE_URL=postgresql://lumni:local-demo-change-me@127.0.0.1:55432/lumni_sql
SESSION_TTL_HOURS=12
# Datos DEMO locales, nunca reutilizar credenciales reales.
DEMO_CLIENT_PASSWORD=ClienteDemo2026!
DEMO_ADMIN_PASSWORD=AdminDemo2026!
# Gemini: clave personal solo en backend; sin clave el chat muestra error recuperable.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Correo: captura local durable; no se envía a un servidor SMTP externo.
EMAIL_POLL_INTERVAL_MS=1000
EMAIL_BATCH_SIZE=20
# Solo desarrollo/test: none, always o first-two.
EMAIL_FAILURE_MODE=none
