{
  "name": "lumni-reservas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.0.0 <25 || >=26.0.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @lumni/shared build && pnpm --parallel --filter @lumni/api --filter @lumni/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @lumni/shared build && pnpm -r typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm --filter @lumni/shared build && pnpm --filter @lumni/shared test && pnpm --filter @lumni/api test",
    "test:integration": "pnpm --filter @lumni/shared build && pnpm --filter @lumni/api test:integration",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build",
    "db:generate": "pnpm --filter @lumni/api db:generate",
    "db:migrate": "pnpm --filter @lumni/api db:migrate",
    "db:seed": "pnpm --filter @lumni/shared build && pnpm --filter @lumni/api db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "doctor": "node scripts/doctor.mjs",
    "dev:setup": "node scripts/setup.mjs",
    "format": "prettier --write apps packages scripts infra \"*.js\" \"*.json\" .prettierrc.json",
    "format:check": "prettier --check apps packages scripts infra \"*.js\" \"*.json\" .prettierrc.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
